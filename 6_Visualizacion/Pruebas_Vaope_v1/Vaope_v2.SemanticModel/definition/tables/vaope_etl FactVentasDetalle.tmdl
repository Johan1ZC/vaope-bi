table 'vaope_etl FactVentasDetalle'
	lineageTag: e2ed18c0-1d09-4496-aec1-9667704ba2d0

	measure 'Ventas sin impuesto' = CALCULATE(SUM('vaope_etl FactVentasDetalle'[SinImpuesto]),'vaope_etl DimEstadoFactura'[EstadoFactura] = "pagada")
		lineageTag: 4338cdf5-e168-4a8f-b738-47565446f452

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margen Bruto' = [Ventas sin impuesto] - [Egresos sin impuesto]
		lineageTag: 5d74844e-4ff2-4376-9412-7dc735a719d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Margen Bruto' = DIVIDE([Margen Bruto],[Ventas sin impuesto])
		lineageTag: 58dd6c7d-52ce-4ff8-9f53-eb7df3e0d1e0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Margen Operativo' = [Ventas sin impuesto] - [Egresos sin impuesto]
		lineageTag: 5b109b94-29c0-4d9c-a801-c0d08f8d157a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Margen Operativo' = DIVIDE([Margen Operativo],[Ventas sin impuesto])
		lineageTag: 85532e1f-c60f-4b20-8dce-a11f5f1ed96f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EBITDA = [Margen Operativo] + 0.18 + 0.15 + 0.25 + 0.23
		lineageTag: e39d2094-d7c3-4d8b-a525-28e94665ac4e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad de Ventas' = COUNT('vaope_etl FactVentasDetalle'[FacturaDetalleID])
		formatString: 0
		lineageTag: cde9af40-a468-4bd9-8144-b183c53aa1d4

	measure 'Ventas sin impuesto(por Organizador)' =
			
			VAR EventosDelOrganizador =
			    CALCULATETABLE (
			        DISTINCT ( 'vaope_etl eventosOrganizador_Detalle'[EventoID]),
			        KEEPFILTERS ( VALUES ( 'vaope_etl DimOrganizadores'[OrganizadorID]) )
			    )
			RETURN
			CALCULATE (
			    [Ventas sin impuesto],
			    TREATAS ( EventosDelOrganizador, 'vaope_etl DimEventos'[EventoID])
			)
		lineageTag: 05e58f02-66d8-49cf-b5ec-26e4c3f174e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Venta sin impuesto(Todos los estados)' = SUM('vaope_etl FactVentasDetalle'[SinImpuesto])
		lineageTag: 764f1db4-7ad4-4f66-8030-0256e8d72263

		annotation PBI_FormatHint = {"isGeneralNumber":true}

