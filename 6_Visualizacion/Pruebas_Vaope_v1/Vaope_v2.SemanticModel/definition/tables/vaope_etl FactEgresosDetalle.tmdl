table 'vaope_etl FactEgresosDetalle'
	lineageTag: ef42ff4b-620f-45c9-9576-01e0cabd70cf

	measure 'Egresos sin impuesto' = CALCULATE(sum('vaope_etl FactEgresosDetalle'[SinImpuesto]),'vaope_etl DimEstadoFactura'[EstadoFactura] = "pagada")
		lineageTag: 1ba38138-aa0d-4326-927b-5ace73509b6e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad de Egresos' = COUNT('vaope_etl FactEgresosDetalle'[FacturaDetalleID])
		formatString: 0
		lineageTag: 8a7fb8d6-99d1-4d4e-a453-9f9d67427130

	measure 'Egresos sin impuesto(por Organizador)' =
			
			VAR EventosDelOrganizador =
			    CALCULATETABLE (
			        DISTINCT ( 'vaope_etl eventosOrganizador_Detalle'[EventoID]),
			        KEEPFILTERS ( VALUES ('vaope_etl DimOrganizadores'[OrganizadorID]) )
			    )
			RETURN
			CALCULATE (
			    [Egresos sin impuesto],
			    TREATAS ( EventosDelOrganizador, 'vaope_etl DimEventos'[EventoID])
			)
		lineageTag: 3f26fa83-81b1-4379-8c88-69f111a3e700

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Egreso sin impuesto (Todos los estados)' = sum('vaope_etl FactEgresosDetalle'[SinImpuesto])
		lineageTag: 0ae782fa-c857-4a09-a109-71b69e06ab75

		annotation PBI_FormatHint = {"isGeneralNumber":true}

